# Server Configuration
PORT=5000
NODE_ENV=development

# Google Drive OAuth Configuration (for Render deployment)
# Copy the ENTIRE contents of oauth-credentials.json as a single line JSON string
GOOGLE_OAUTH_CREDENTIALS={"installed":{"client_id":"xxx","client_secret":"xxx","redirect_uris":["http://localhost"]}}

# Copy the ENTIRE contents of oauth-token.json as a single line JSON string
GOOGLE_OAUTH_TOKEN={"access_token":"xxx","refresh_token":"xxx","scope":"xxx","token_type":"Bearer","expiry_date":xxx}
